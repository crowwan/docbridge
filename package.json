{
  "name": "docbridge",
  "version": "0.1.0",
  "private": true,
  "description": "Claude 채팅에서 한글(HWP/HWPX) 문서를 묻고 고치는 로컬 브리지",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "demo": "npm run build && node scripts/demo/record-demo.ts",
    "pack": "vite build && node scripts/pack/pack.ts",
    "test:pack": "npm run pack && vitest run --config vitest.pack.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@rhwp/core": "0.8.7",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
